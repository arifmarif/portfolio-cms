generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id        String   @id @default("singleton")
  published Json
  draft     Json
  updatedAt DateTime @updatedAt
}

model Project {
  id            String    @id
  slug          String    @unique
  title         String
  titleEn       String?
  category      String
  categoryEn    String?
  excerpt       String
  excerptEn     String?
  description   String
  descriptionEn String?
  thumbnailUrl  String
  altText       String
  altTextEn     String?
  tags          String[]
  tagsEn        String[]  @default([])
  client        String?
  year          String?
  status        String
  order         Int
  featured      Boolean   @default(false)
  gallery       Json
  caseBackground       String?
  caseBackgroundEn     String?
  caseChallenge        String?
  caseChallengeEn      String?
  caseRole             String?
  caseRoleEn           String?
  caseImplementation   String[]  @default([])
  caseImplementationEn String[]  @default([])
  caseTech             String?
  caseTechEn           String?
  caseResults          String?
  caseResultsEn        String?
  idUpdatedAt   DateTime?
  enUpdatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DownloadSubmission {
  id        String   @id
  email     String
  phone     String
  pdfName   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
